NEXT_PUBLIC_SUPABASE_URL=

# Preferred (new API keys — Settings → API Keys → Publishable and secret)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret (sb_secret_...). Never commit. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Legacy fallbacks (anon / service_role JWT) — still work until you deactivate them
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Friend-beta: leave unset/false so Ask AI stays a "coming soon" placeholder.
# NEXT_PUBLIC_AI_ENABLED=true
