NEXT_PUBLIC_SUPABASE_URL=

# Preferred (new API keys — Settings → API Keys → Publishable and secret)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret (sb_secret_...). Never commit. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Legacy fallbacks (anon / service_role JWT) — still work until you deactivate them
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Friend-beta: leave unset/false so Ask AI stays a "coming soon" placeholder.
# NEXT_PUBLIC_AI_ENABLED=true
#
# Edge Function kill-switch (Supabase Dashboard → Edge Functions → ai → Secrets).
# Must be exactly "true" or the function returns 503 AI_DISABLED — even if UI flag is on.
# AI_ENABLED=true
#
# Optional Edge-only secret for stronger userHash in AI logs (never commit the value):
# LOG_HASH_SALT=
#
# Optional Edge-only CORS allowlist extras (comma-separated origins).
# Defaults already include http://localhost:3000 and https://cosmictrack-react.netlify.app
# CORS_ALLOWED_ORIGINS=https://preview-xyz.netlify.app

# Playwright auth E2E (optional). Use a dedicated throwaway Supabase user — never a real account.
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=

